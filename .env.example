# PortalX Server Environment Configuration

# Server Port
PORT=3000

# Environment Mode (development | production | test)
NODE_ENV=development

# Express Session Secret (use a long, random string in production)
SESSION_SECRET=portalx_super_secret_dev_key_change_in_production

# SRM University-AP Student Corner Base URL
SRM_BASE_URL=https://student.srmap.edu.in/srmapstudentcorner

# SRM Request Timeout in Milliseconds (e.g. 15000 = 15 seconds)
SRM_REQUEST_TIMEOUT_MS=15000

# Development Mock Mode (true / false)
# When set to true in development, provides sample SRM responses for testing UI views when not connected to university network
DEV_MOCK_FALLBACK=false

