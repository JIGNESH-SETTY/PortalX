{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/tesseract.js-core/**,eng.traineddata}"
    },
    "src/app.js": {
      "includeFiles": "{node_modules/tesseract.js-core/**,eng.traineddata}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
